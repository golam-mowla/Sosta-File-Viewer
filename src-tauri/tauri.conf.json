{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sosta File Viewer",
  "version": "0.0.0",
  "identifier": "com.sosta.fileviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sosta File Viewer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Adobe Portable Document Format",
        "role": "Viewer"
      },
      {
        "ext": ["epub", "mobi", "cbz", "cbr"],
        "name": "E-Book Document",
        "description": "Electronic Publication Document",
        "role": "Viewer"
      },
      {
        "ext": ["docx", "xlsx", "txt", "md", "json"],
        "name": "Universal Document",
        "description": "Universal Document File",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
